# GoHighLevel inbound webhook for the correct mortgage sub-account.
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
#
# In GHL: Automation > Workflows > new workflow > trigger "Inbound Webhook",
# then copy the webhook URL here.
#
# Until this is set, /api/lead returns 503 with a fallback phone/email message
# rather than pretending the lead was delivered.
GHL_WEBHOOK_URL=
